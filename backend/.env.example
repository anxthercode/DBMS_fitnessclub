# Copy to .env and set your local credentials. Never commit the real .env.
DATABASE_URL=postgresql://northside_app:CHANGE_ME@127.0.0.1:5432/northside
TEST_DATABASE_URL=postgresql://northside_app:CHANGE_ME@127.0.0.1:5432/northside_test
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173"]
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT=10
FRONTEND_URL=http://127.0.0.1:5173
COOKIE_SECURE=false
SESSION_HOURS=168
# Email delivery, verification and recovery are disabled. SMTP is not required.
